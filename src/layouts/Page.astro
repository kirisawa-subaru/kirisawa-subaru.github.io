---
// Layout for plain markdown pages in src/pages/*.md (e.g. about.md).
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description} nav={frontmatter.nav}>
  <div class="shell page">
    {frontmatter.kicker && <p class="kicker">{frontmatter.kicker}</p>}
    <h1 class="display">{frontmatter.title}</h1>
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .page {
    max-width: 900px;
    margin-inline: auto;
    padding-top: 56px;
  }

  h1 {
    margin-bottom: 36px;
    font-size: clamp(44px, 6vw, 72px);
  }
</style>
