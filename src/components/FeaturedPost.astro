---
import { accentOf, formatDate, postUrl, readingMinutes, type Post } from '../lib/posts';
import TagList from './TagList.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, tags, draft } = post.data;
---

<article class="featured" data-accent={accentOf(post)}>
  <div class="featured-top">
    <span class="label">Latest</span>
    <time class="meta" datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="meta">· {readingMinutes(post.body)} min</span>
    {draft && <span class="pill pill--draft">Draft</span>}
  </div>
  <h2 class="display"><a href={postUrl(post)}>{title}</a></h2>
  {description && <p class="desc">{description}</p>}
  <div class="featured-foot">
    <TagList tags={tags} />
    <a class="button button--primary" href={postUrl(post)}>Read <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .featured {
    position: relative;
    padding: clamp(28px, 4vw, 48px);
    background: var(--tint);
    border: 1px solid rgba(23, 26, 29, 0.06);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .featured::after {
    position: absolute;
    top: -80px;
    right: -80px;
    width: 260px;
    height: 260px;
    border: 1px solid rgba(23, 26, 29, 0.1);
    border-radius: 50%;
    box-shadow: 0 0 0 40px rgba(255, 255, 255, 0.18), 0 0 0 80px rgba(255, 255, 255, 0.12);
    content: '';
    pointer-events: none;
  }

  .featured-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .label {
    padding: 3px 11px;
    color: #fff;
    background: var(--ink);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 820px;
    margin-top: 22px;
    font-size: clamp(32px, 4.6vw, 56px);
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--dot);
  }

  .desc {
    max-width: 680px;
    margin: 18px 0 0;
    color: rgba(23, 26, 29, 0.72);
    font-size: 17px;
  }

  .featured-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
  }
</style>
