---
import { SITE } from '../site.config';
---

<section class="intro" aria-labelledby="intro-title">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="glow glow--one" aria-hidden="true"></div>
  <div class="glow glow--two" aria-hidden="true"></div>
  <div class="column">
    <p class="kicker">{SITE.kicker}</p>
    <h1 id="intro-title" class="display">Kirisawa <span>Subaru</span></h1>
    <p class="tagline">{SITE.tagline}</p>
  </div>
</section>

<style>
  .intro {
    position: relative;
    padding: 44px 0 36px;
    isolation: isolate;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    opacity: 0.45;
    background-image:
      linear-gradient(rgba(23, 26, 29, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 26, 29, 0.045) 1px, transparent 1px);
    background-size: 54px 54px;
    -webkit-mask-image: linear-gradient(to bottom, black 10%, transparent 92%);
    mask-image: linear-gradient(to bottom, black 10%, transparent 92%);
  }

  .glow {
    position: absolute;
    z-index: -2;
    border-radius: 50%;
    filter: blur(8px);
    pointer-events: none;
  }

  .glow--one {
    top: -60%;
    right: 6%;
    width: 380px;
    height: 380px;
    background: rgba(182, 162, 238, 0.2);
  }

  .glow--two {
    bottom: -90%;
    left: -8%;
    width: 340px;
    height: 340px;
    background: rgba(184, 216, 137, 0.22);
  }

  h1 {
    font-size: clamp(40px, 5vw, 60px);
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  h1 span {
    color: var(--blue);
    font-style: italic;
  }

  .tagline {
    max-width: 640px;
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.4;
  }
</style>
