---
import { formatDate, postUrl, readingMinutes, type Post } from '../lib/posts';
import TagList from './TagList.astro';

interface Props {
  posts: Post[];
  /** Give the newest post a slightly larger row with a "Latest" label. */
  highlightFirst?: boolean;
}

const { posts, highlightFirst = false } = Astro.props;

const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const y = post.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const first = posts[0];
---

<div class="years">
  {[...byYear.entries()].map(([year, items]) => (
    <section class="year">
      <h2 class="year-label">{year}</h2>
      <ol class="rows">
        {items.map((post) => {
          const lead = highlightFirst && post === first;
          return (
            <li class:list={['row', { 'row--lead': lead }]}>
              <div class="row-meta">
                <time class="meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date).slice(5)}</time>
                {lead && <span class="latest">Latest</span>}
              </div>
              <div class="row-body">
                <h3>
                  <a href={postUrl(post)}>{post.data.title}</a>
                  {post.data.draft && <span class="pill pill--draft">Draft</span>}
                </h3>
                {post.data.description && <p>{post.data.description}</p>}
                <span class="meta row-time">约 {readingMinutes(post.body)} 分钟</span>
              </div>
              <TagList tags={post.data.tags} />
            </li>
          );
        })}
      </ol>
    </section>
  ))}
</div>

<style>
  .years {
    display: grid;
    gap: 28px;
  }

  .year {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 20px;
    border-top: 1px solid var(--line);
  }

  .year-label {
    position: sticky;
    top: 92px;
    align-self: start;
    margin: 20px 0 0;
    color: var(--ink-faint);
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 18px;
    padding: 20px 16px;
    border-radius: var(--radius-sm);
    transition: background 160ms ease;
  }

  .row + .row::before {
    position: absolute;
    top: 0;
    right: 16px;
    left: 16px;
    height: 1px;
    background: var(--line);
    content: '';
  }

  .row:hover {
    background: rgba(255, 255, 255, 0.62);
  }

  .row:hover::before,
  .row:hover + .row::before {
    opacity: 0;
  }

  .row-meta {
    display: grid;
    gap: 6px;
  }

  .latest {
    justify-self: start;
    padding: 1px 8px;
    color: #fff;
    background: var(--ink);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .row--lead h3 {
    font-size: 26px;
    letter-spacing: -0.025em;
  }

  h3 a {
    text-decoration: none;
  }

  /* The whole row is the link target; tag pills stay separately clickable. */
  h3 a::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    content: '';
  }

  .row:hover h3 a {
    text-decoration: underline;
    text-decoration-color: rgba(49, 89, 217, 0.45);
    text-decoration-thickness: 1.5px;
  }

  .row-body p {
    margin: 6px 0 0;
    color: var(--ink-soft);
    font-size: 15px;
  }

  .row--lead .row-body p {
    font-size: 16px;
  }

  .row-time {
    display: inline-block;
    margin-top: 6px;
    font-size: 12px;
  }

  .row :global(.tags) {
    position: relative;
    z-index: 2;
    justify-content: flex-end;
    max-width: 220px;
  }

  @media (max-width: 760px) {
    .year {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .year-label {
      position: static;
      margin: 16px 0 4px;
      font-size: 22px;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 16px 6px;
    }

    .row-meta {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .row--lead h3 {
      font-size: 23px;
    }

    .row :global(.tags) {
      justify-content: flex-start;
      max-width: none;
    }
  }
</style>
