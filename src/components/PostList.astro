---
import { accentOf, formatDate, postUrl, type Post } from '../lib/posts';
import TagList from './TagList.astro';

interface Props {
  posts: Post[];
  offset?: number;
}

const { posts, offset = 0 } = Astro.props;

const byYear = new Map<number, { post: Post; index: number }[]>();
posts.forEach((post, i) => {
  const y = post.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push({ post, index: i + offset });
});
---

<div class="years">
  {[...byYear.entries()].map(([year, items]) => (
    <section class="year">
      <h3 class="year-label">{year}</h3>
      <ol class="rows">
        {items.map(({ post, index }) => (
          <li class="row" data-accent={accentOf(post, index)}>
            <time class="meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date).slice(5)}</time>
            <div class="row-body">
              <h4>
                <a href={postUrl(post)}>{post.data.title}</a>
                {post.data.draft && <span class="pill pill--draft">Draft</span>}
              </h4>
              {post.data.description && <p>{post.data.description}</p>}
            </div>
            <TagList tags={post.data.tags} />
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<style>
  .years {
    display: grid;
    gap: 36px;
  }

  .year {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 24px;
  }

  .year-label {
    position: sticky;
    top: 96px;
    align-self: start;
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--ink-faint);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 20px;
    padding: 20px 18px;
    border-bottom: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: background 180ms ease;
  }

  .row:hover {
    background: var(--tint);
  }

  .row::before {
    position: absolute;
    top: 30px;
    left: -2px;
    width: 8px;
    height: 8px;
    background: var(--dot);
    border-radius: 50%;
    content: '';
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .row:hover::before {
    opacity: 1;
  }

  h4 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  h4 a {
    text-decoration: none;
  }

  h4 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .row-body p {
    margin: 6px 0 0;
    color: var(--ink-soft);
    font-size: 15px;
  }

  .row :global(.tags) {
    position: relative;
    z-index: 1;
    justify-content: flex-end;
    max-width: 220px;
  }

  @media (max-width: 760px) {
    .year {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .year-label {
      position: static;
      margin: 0;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 18px 4px;
    }

    .row :global(.tags) {
      justify-content: flex-start;
      max-width: none;
    }
  }
</style>
