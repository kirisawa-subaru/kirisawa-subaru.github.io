---
import Base from '../layouts/Base.astro';
import { formatDate, getPosts, postUrl } from '../lib/posts';

const latest = (await getPosts()).filter((p) => !p.data.draft).slice(0, 5);
---

<Base title="Not found">
  <div class="shell page">
    <p class="kicker">404</p>
    <h1 class="display">这一页不存在。</h1>
    {latest.length > 0 && (
      <section>
        <p class="meta">最近的文章</p>
        <ul>
          {latest.map((p) => (
            <li>
              <a href={postUrl(p)}>{p.data.title}</a>
              <time class="meta" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>
    )}
    <p><a class="button button--primary" href="/">回到首页 →</a></p>
  </div>
</Base>

<style>
  .page {
    padding: 80px 0;
  }

  h1 {
    margin-bottom: 32px;
    font-size: clamp(40px, 6vw, 64px);
  }

  ul {
    margin: 8px 0 32px;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    max-width: var(--measure);
    border-bottom: 1px solid var(--line);
  }

  li a {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    text-decoration: none;
  }

  li a:hover {
    color: var(--blue);
  }
</style>
