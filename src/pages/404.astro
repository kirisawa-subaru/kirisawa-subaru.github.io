---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="shell page">
    <p class="kicker">404</p>
    <h1 class="display">这一页不存在。</h1>
    <p><a class="button button--primary" href="/">回到首页 →</a></p>
  </div>
</Base>

<style>
  .page {
    padding: 96px 0;
  }

  h1 {
    margin-bottom: 32px;
    font-size: clamp(40px, 6vw, 72px);
  }
</style>
