---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base nav="writing">
  <Intro />
  <div class="shell home">
    {posts.length ? <PostList posts={posts} highlightFirst /> : <p class="empty">还没有文章。</p>}
    <p class="more"><a href="/tags/">按标签浏览 →</a></p>
  </div>
</Base>

<style>
  .home {
    padding-top: 8px;
  }

  .empty {
    color: var(--ink-soft);
  }

  .more {
    margin: 28px 0 0;
  }

  .more a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--ink-soft);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .more a:hover {
    color: var(--blue);
  }
</style>
